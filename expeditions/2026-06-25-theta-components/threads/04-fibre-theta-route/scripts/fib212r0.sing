LIB "primdec.lib";
// (2,1,2) r=0: A_1: 1x2 (d0=2 -> d1=1), A_2: 2x1 (d1=1 -> d2=2). mult=A_2*A_1: 2x2. E=0.
ring R = 0, (a1,a2, b1,b2), dp;   // A_1 = [a1 a2] (1x2), A_2 = [b1;b2] (2x1)
matrix A[1][2]=a1,a2;
matrix B[2][1]=b1,b2;
matrix P=B*A;   // 2x2
ideal I=P[1,1],P[1,2],P[2,1],P[2,2];
ideal sI=std(I);
int cod=4-dim(sI);
"212r0 DIM:",dim(sI),"CODIM:",cod;
list mp=minAssGTZ(I);
"212r0 NMINPRIMES:",size(mp);
int i;int top=0;
for(i=1;i<=size(mp);i++){int dd=dim(std(mp[i])); if(4-dd==cod){top=top+1;} "  comp",i,"codim",4-dd,"gens:",mp[i];}
"212r0 TOP:",top;
quit;
