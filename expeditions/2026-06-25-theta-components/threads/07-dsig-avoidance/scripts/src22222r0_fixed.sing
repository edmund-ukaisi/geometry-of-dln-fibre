LIB "primdec.lib";
// (2,2,2,2,2): 5 vertices => N=4 arrows => 4 factors. mult=A4*A3*A2*A1. r=0 => P=0.
ring R = 0, (a11,a12,a21,a22, b11,b12,b21,b22, c11,c12,c21,c22, d11,d12,d21,d22), dp;
matrix A1[2][2]=a11,a12,a21,a22;
matrix A2[2][2]=b11,b12,b21,b22;
matrix A3[2][2]=c11,c12,c21,c22;
matrix A4[2][2]=d11,d12,d21,d22;
matrix P = A4*A3*A2*A1;
ideal I = P[1,1],P[1,2],P[2,1],P[2,2];
int nv=nvars(R);
"nvars =",nv;
list pd = minAssGTZ(I);
"num minimal primes =",size(pd);
int i; int dmax=-1; intvec dims;
for(i=1;i<=size(pd);i++){ ideal pri=std(pd[i]); int di=dim(pri); dims[i]=di; if(di>dmax){dmax=di;} }
"dims =",dims," max dim =",dmax," min codim =",nv-dmax;
int ntop=0;
for(i=1;i<=size(pd);i++){ if(dims[i]==dmax){ntop++;} }
"num TOP-dim components =",ntop;
"(r=0: detDelta=det(empty)=1, unit; W1 automatic.)";
quit;
