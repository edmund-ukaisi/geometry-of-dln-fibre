LIB "primdec.lib";
// (3,3,3): N=2, two 3x3 factors A1,A2. mult=A2*A1. r=2 => Sigma^2={rank P<=2}={det P=0}.
ring R = 0, (a11,a12,a13,a21,a22,a23,a31,a32,a33, b11,b12,b13,b21,b22,b23,b31,b32,b33), dp;
matrix A1[3][3] = a11,a12,a13,a21,a22,a23,a31,a32,a33;
matrix A2[3][3] = b11,b12,b13,b21,b22,b23,b31,b32,b33;
matrix P = A2*A1;
ideal I = det(P);                       // (r+1)=3 minor of 3x3 product = det P
matrix Ptl[2][2] = P[1,1],P[1,2],P[2,1],P[2,2];
poly detD = det(Ptl);                   // top-left 2x2 minor of product
int nv = nvars(R);
"nvars =", nv;
list pd = minAssGTZ(I);
"num minimal primes =", size(pd);
int i; int dmax=-1; intvec dims;
for (i=1; i<=size(pd); i++) { ideal pri=std(pd[i]); int di=dim(pri); dims[i]=di; if(di>dmax){dmax=di;} }
"dims =", dims, "  max dim =", dmax, " min codim =", nv-dmax;
"--- top-dim components: NF(detD) (0=>BAD) ---";
for (i=1;i<=size(pd);i++){ if(dims[i]==dmax){ ideal pri=std(pd[i]); "COMP",i," codim=",nv-dims[i]; "  gens:",pd[i]; "  detD in p?  NF=",reduce(detD,pri); } }
quit;
