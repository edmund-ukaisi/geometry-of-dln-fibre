LIB "primdec.lib";
// (2,2,2,2): N=3, three 2x2 factors A1,A2,A3. mult = A3*A2*A1. d=(2,2,2,2), r=1.
// Sigma^1 = {rank(P) <= 1}, P 2x2 => det P = 0.
ring R = 0, (a11,a12,a21,a22, b11,b12,b21,b22, c11,c12,c21,c22), dp;
matrix A1[2][2] = a11,a12,a21,a22;
matrix A2[2][2] = b11,b12,b21,b22;
matrix A3[2][2] = c11,c12,c21,c22;
matrix P = A3*A2*A1;
ideal I = det(P);          // (r+1)=2 minors of 2x2 product = det P
poly detD = P[1,1];        // top-left 1x1 minor of product
int nv = nvars(R);
"nvars =", nv;
list pd = minAssGTZ(I);
"num minimal primes =", size(pd);
int i; int dmax=-1; intvec dims;
for (i=1; i<=size(pd); i++) { ideal pri=std(pd[i]); int di=dim(pri); dims[i]=di; if(di>dmax){dmax=di;} }
"dims =", dims, "  max dim =", dmax, " min codim =", nv-dmax;
"--- top-dim components: NF(detD) (0=>BAD) ---";
for (i=1;i<=size(pd);i++){ if(dims[i]==dmax){ ideal pri=std(pd[i]); "COMP",i," codim=",nv-dims[i]; "  gens:",pd[i]; "  NF(detD)=",reduce(detD,pri); } }
quit;
