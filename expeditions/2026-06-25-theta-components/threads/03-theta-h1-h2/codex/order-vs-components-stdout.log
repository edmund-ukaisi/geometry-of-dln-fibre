1839:\\ \rlcm(FG) =&\left\{\begin{array}{cl}
1840:  \rlcm(F)   & \text{if}\ \rlct(F)<\rlct(G) \\
1841:   \rlcm(G)  & \text{if}\ \rlct(F)>\rlct(G) \\
1842:   \rlcm(F)+\rlcm(G)  & \text{if}\ \rlct(F)=\rlct(G).
1847:\rlct(F+G)=\rlct(F)+\rlct(G)\quad \text{ and }\quad \rlcm(F+G)=\rlcm(F)+\rlcm(G)-1
