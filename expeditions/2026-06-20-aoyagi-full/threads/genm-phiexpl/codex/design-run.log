    have hstrict : HasStrictFDerivAt (hΦat.localInverse hΦ' hn) (f'.symm : E →L[ℝ] E) (Φ wstar) :=
      (hΦat.hasStrictFDerivAt' hΦ' hn).to_localInverse
    have : HasFDerivAt (h.symm : E → E) (f'.symm : E →L[ℝ] E) (Φ wstar) := hstrict.hasFDerivAt
