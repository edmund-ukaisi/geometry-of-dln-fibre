  -- ≠ 0`.
  have hsymm_fderiv_contOn : ContinuousOn (fun w => fderiv ℝ (h.symm : E → E) w) Usymm' :=
    hUsymm'_cd.continuousOn_fderiv_of_isOpen hUsymm'open (by norm_num)
