# ---------------------------------------------------------------------------
def Mval(M, t):
    """Aoyagi terminal divisor exponent for chain M=(M1..M_{L+1}) (1-indexed here as tuple)
    and rank profile t=(t1..tL):
      Mval = (M1-t1)(M2-t1) + sum_{j=2}^L (t_{j-1}-t_j)(M_{j+1}-t_j)."""
    L = len(t)
    val = (M[0]-t[0])*(M[1]-t[0])
    for j in range(2, L+1):
        val += (t[j-2]-t[j-1])*(M[j]-t[j-1])
    return val

