/bin/bash -lc "python3 - <<'PY'

def intervals(N): return [(a,b) for a in range(N+1) for b in range(a,N+1)]
def rank(N,m): return {(i,j):sum(m.get((a,b),0) for a,b in intervals(N) if a<=i and j<=b) for i in range(N+1) for j in range(i,N+1)}
def all_m_for_d(N,d):
 ints=intervals(N); res=[]; cur={}; rem=list(d)
 def rec(k):
  if k==len(ints):
   if all(x==0 for x in rem): res.append(cur.copy())
   return
  a,b=ints[k]; maxcnt=min(rem[t] for t in range(a,b+1))
  for v in range(maxcnt+1):
   if v: cur[(a,b)]=v
   else: cur.pop((a,b),None)
   for t in range(a,b+1): rem[t]-=v
   rec(k+1)
   for t in range(a,b+1): rem[t]+=v
  cur.pop((a,b),None)
 rec(0); return res

def ne(g):
 supp=[k for k,v in g.items() if v>0]
 a=min(i for i,j in supp); e=max(j for i,j in supp if i==a)
 return a,e

def frontier_rule(N,m,g,a,e):
 for c in range(a+1,e+1):
  if any(g.get((i,e),0)==0 for i in range(a,c)):
   continue
  zeros=[]
  for i in range(a,c):
   for j in range(i,e): # j<e
    if g.get((i,j),0)==0:
     zeros.append(j)
  b=max(zeros) if zeros else c-1
  if b < c-1: b=c-1
  if b>=e: continue
  D=[(i,j) for i in range(a,c) for j in range(b+1,e+1) if i<=j]
  if not all(g.get(x,0)>0 for x in D):
   return ('badD',c,b,D,[(x,g.get(x,0)) for x in D])
  if c==b+1 or m.get((c,b),0)>0:
   return (c,b,D)
 return None
for N,d in [(3,(1,2,2,1)),(4,(1,2,3,2,1)),(3,(2,2,2,2)),(4,(2,2,2,2,2)),(4,(1,3,3,3,1)),(5,(1,2,3,3,2,1))]:
 ms=all_m_for_d(N,d); ranks=[rank(N,m) for m in ms]
 fails=0; ex=None; pairs=0
 for r,m in zip(ranks,ms):
  for s in ranks:
   if all(s[k]<=r[k] for k in r) and any(s[k]<r[k] for k in r):
    pairs+=1; g={k:r[k]-s[k] for k in r}; a,e=ne(g)
    res=frontier_rule(N,m,g,a,e)
    if not res or (isinstance(res,tuple) and res and res[0]=='badD'):
     fails+=1; ex=(N,d,m,s,a,e,res,g); break
  if fails: break
 print('case',N,d,'#m',len(ms),'pairs',pairs,'fails',fails)
 if ex: print(' ex',ex[:7])
