lean/DLNFibre/Core/NullstellensatzCodim.lean:56:def IsZariskiClosed (Z : Set (σ → k)) : Prop :=
lean/DLNFibre/Core/NullstellensatzCodim.lean:57:  Z = zeroLocus k (vanishingIdeal k Z)
