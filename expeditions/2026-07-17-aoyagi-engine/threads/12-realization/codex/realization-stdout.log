from functools import lru_cache
from itertools import product

def level(t): return min(t)
def set_tail(t,S,J):
    # S is 1-based
    return t[:S-1] + (J,)*(len(t)-S+1)

def profiles(M, stats=False):
    L=len(M)-1
    seen=set(); leaves=set(); out=set(); transitions=[0]
    def visit(S,J,divs):
        state=(S,J,divs)
        if state in seen: return
        seen.add(state)
        if S==L+1:
            leaves.add(divs)
            out.update(t for t in divs if level(t)==0)
            return
        mr=min(M[:S]); msp1=min(mr,M[S])
        if J>=msp1:
            visit(S+1,0,divs); return
        targets=[level(t) for t in divs if J+1<=level(t)<=mr-1]
        if targets:
            target=min(targets)
            candidates=[t for t in divs if level(t)==target]
            # componentwise-least; verify unique value among possible minima
            least=[t for t in candidates if all(all(x<=y for x,y in zip(t,u)) for u in candidates)]
            assert least, (M,state,candidates)
            f=min(least)
            c=set_tail(f,S,J)
            dl=list(divs); dl.remove(f); dl.append(c)
            visit(S,J,tuple(sorted(dl)))
            visit(S,J+1,tuple(sorted(divs+(c,))))
        else:
            c=tuple([min(M[:i+1]) for i in range(1,S)] + [J]*(L-S+1))
            visit(S,J+1,tuple(sorted(divs+(c,))))
    visit(1,0,())
    if stats: return out,len(seen),len(leaves),leaves
    return out

def adm(M):
    L=len(M)-1
    bounds=[min(M[:i+1]) for i in range(1,L+1)] # M(i+1)
    return {a for a in product(*(range(b+1) for b in bounds)) if a[-1]==0 and all(a[i]>=a[i+1] for i in range(L-1))}

def mval(M,a):
    return (M[0]-a[0])*(M[1]-a[0])+sum((a[j-1]-a[j])*(M[j+1]-a[j]) for j in range(1,len(a)))

M=(3,3,4,2,3)
P,ns,nl,leaves=profiles(M,True)
A=adm(M)
print('M',M,'states',ns,'leaves',nl,'|P|',len(P),'|Adm|',len(A))
print('P')
for x in sorted(P,reverse=True): print(x)
print('Adm')
for x in sorted(A,reverse=True): print(x)
print('Adm-P',sorted(A-P,reverse=True))
print('P-Adm',sorted(P-A,reverse=True))
vals={a:mval(M,a) for a in A}
mn=min(vals.values())
print('min mval',mn,'minimizers',sorted(a for a,v in vals.items() if v==mn),'realized',sorted(a for a,v in vals.items() if v==mn and a in P))
