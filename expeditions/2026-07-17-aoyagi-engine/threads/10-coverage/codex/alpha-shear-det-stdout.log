lemma prod_smul_left {μ : Measure α} (c : ℝ≥0∞) : (c • μ).prod ν = c • (μ.prod ν) := by
  ext s hs
  rw [Measure.prod_apply hs, Measure.smul_apply, Measure.prod_apply hs]
