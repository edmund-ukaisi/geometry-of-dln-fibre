A=s.Matrix([[a11,a12],[a21,a22]])
B=s.Matrix(2,2,s.symbols('b11 b12 b21 b22'))
C=s.Matrix(2,2,s.symbols('c11 c12 c21 c22'))
D=s.Matrix(2,2,s.symbols('d11 d12 d21 d22'))
C1=A.row_join(B).col_join(C.row_join(D))
Ai=A.inv()
L=Ai.row_join(s.zeros(2)).col_join((-C*Ai).row_join(s.eye(2)))
R=s.eye(2).row_join(-Ai*B).col_join(s.zeros(2).row_join(s.eye(2)))
Delta=s.simplify(D-C*Ai*B)
peel=s.simplify(L*C1*R-s.eye(2).row_join(s.zeros(2)).col_join(s.zeros(2).row_join(Delta)))
print('PEEL_ZERO', peel==s.zeros(4))
print('DET_L', s.factor(L.det()), 'DET_R', s.factor(R.det()))

T=s.Matrix(2,4,s.symbols('t0:8'))
S=s.Matrix(2,4,s.symbols('z0:8'))
Z=T.col_join(S)
C2=s.simplify(R*Z)
prod=s.simplify(C1*C2)
peeled=T.col_join(Delta*S)
print('PRODUCT_ID', s.simplify(prod-L.inv()*peeled)==s.zeros(4,4))

# Radial charts: T=q*Tbar with one unit; Delta=a*Dbar with one unit.
q,a,E,alpha=s.symbols('q a E alpha')
tbar=[s.Integer(1)]+list(s.symbols('tb1:8'))
u,v,w=s.symbols('u v w')
Dbar=s.Matrix([[1,u],[v,w]])
Zfree=s.Matrix(2,4,s.symbols('s0:8'))
heart=list(Dbar*Zfree)
gens=[q*x for x in tbar]+[a*x for x in heart]
joined=[s.expand(g.subs({q:E,a:E*alpha}, simultaneous=True)) for g in gens]
vars_=sorted(set().union(*(g.free_symbols for g in joined)), key=lambda x:x.name)
poly_quotients=[]
for g in joined:
    quo=s.cancel(g/E)
    poly_quotients.append(quo.is_polynomial(*vars_))
G=s.groebner(joined,*vars_,order='grevlex')
GE=s.groebner([E],*vars_,order='grevlex')
ideal_eq=all(GE.reduce(g)[1]==0 for g in joined) and G.reduce(E)[1]==0
print('JOIN_ALL_E_QUOTIENTS_POLYNOMIAL', all(poly_quotients))
print('JOIN_HAS_LITERAL_E', joined[0]==E)
print('GROEBNER_JOIN_IDEAL_EQ_E', ideal_eq)

# Exact Jacobian exponents and ratio.
jac=s.expand(q**7*a**3*E).subs({q:E,a:E*alpha}, simultaneous=True)
hE=s.Poly(jac,E).degree()
print('JAC_JOIN',s.factor(jac),'H_E',hE,'RATIO',Fraction(hE+1,2))

# Exact chain test for the terminal convention, naming products by threshold.
U1,U2,U3=s.symbols('U1 U2 U3')
bvec=[E,E*U1,E*U1*U2,E*U1*U2*U3]
chain=[]
for x,y in zip(bvec,bvec[1:]):
    quo=s.cancel(y/x)
    chain.append(quo.is_polynomial(E,U1,U2,U3) and s.expand(quo*x-y)==0)
print('B_VECTOR',bvec)
print('CHAIN_QUOTIENTS',[s.cancel(y/x) for x,y in zip(bvec,bvec[1:])],all(chain))
print('PRINCIPAL_GB', all(s.groebner([E],E,U1,U2,U3).reduce(b)[1]==0 for b in bvec) and s.groebner(bvec,E,U1,U2,U3).reduce(E)[1]==0)

# Exact LP reduced analytically: q cost 8 is forced; heart cost min over wa.
# For fixed wa in [0,1], sigma cost=4(1-wa), and min e/z cost=(1-wa), so total heart=4wa+5(1-wa)=5-wa.
# For wa>=1, cost >=4. Thus heart min=4 at wa=1; total numerator 12.
wa=s.symbols('wa', real=True)
heart_cost=s.expand(4*wa+5*(1-wa))
print('LP_HEART_COST_[0,1]',heart_cost,'MIN_AT_1',heart_cost.subs(wa,1))
print('LP_TOTAL_RATIO',Fraction(8+4,2))
