abbrev SchurLoc (q p r : ℕ) : Type u :=
  Localization.Away (detSchurS (k := k) q p r)

/-- **The localized block equivalence** `Ψ : A_loc ≃ₐ[k] MvPolynomial B22block Sd`, localizing the
