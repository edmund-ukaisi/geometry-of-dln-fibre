example {σ : Type*} [Finite σ] (P : Ideal (MvPolynomial σ k)) [P.IsPrime] :
    (P.height : WithBot ℕ∞) + ringKrullDim (MvPolynomial σ k ⧸ P) = (Nat.card σ : WithBot ℕ∞) :=
  height_add_ringKrullDim_quotient_eq_card P

