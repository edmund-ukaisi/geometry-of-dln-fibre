    10	/-!
    11	# `DLNFibre.Core.FlatTrivialProductProbe` — the L1-0 `Module.Flat` API-surface contract
    12	
    13	**Status: API contract / checkpoint artefact, NOT the L1-0 theorem.** L1-0 (flatness of `mult`
    14	restricted to a rank-`r` chart) was **checkpointed, not proved** (thread 04, 2026-06-23): the
    15	`Module.Flat` *API* is fully viable at Mathlib v4.29 — every lever the local-triviality⟹trivial-
    16	product⟹free⟹flat route needs is present and compiles (the `example`-blocks below are the durable
    17	pins) — but the route is **unreachable this run** because the prerequisite object is missing: there
    18	is no coordinate-ring pullback `A →+* B` of `mult` (the engine carries `mult` only as a *set-level*
    19	function on `Tuple d`, with codim read through `vanishingIdeal`/`Ideal.height`; no `Spec`, no
    20	scheme, no algebra map between the base/total coordinate quotient rings). Building that ring map +
    21	the
    22	determinantal chart localisation + the section-of-the-torsor trivialisation is a from-scratch
    23	affine-AG construction (≈ 8–12 modules), not an API gap. See the thread-04 report for the verdict
    24	and the recommended fallback (the two-inequality dimension sandwich).
    25	
    26	This module records the **verified-present API** as `example`-blocks so the next attempt (or the
    27	real L1-0, once the ring map exists) can stand on confirmed contracts rather than re-probing.
    28	
    29	**Dependency rule:** `Core` only — never import `DLNFibre.DLN`.
    30	-/
    31	
    32	namespace DLNFibre.Core.FlatProbe
    33	
    34	open scoped TensorProduct
    35	
    36	universe u
    37	
    38	/-! ## Free ⟹ flat, and the polynomial / tensor trivial-product shapes -/
    39	
    40	/-- Free modules are flat (instance), the base of the route. -/
    41	example (A M : Type u) [CommRing A] [AddCommGroup M] [Module A M] [Module.Free A M] :
    42	    Module.Flat A M := inferInstance
    43	
    44	/-- `MvPolynomial (Fin r) A` is free, hence flat, over `A` — the trivial-product model fibre. -/
    45	example (A : Type u) [CommRing A] (r : ℕ) :
    46	    Module.Flat A (MvPolynomial (Fin r) A) := inferInstance
    47	
    48	/-- Tensor of frees is free over the base — the `A ⊗ F` trivial-product shape. -/
    49	example (A F : Type u) [CommRing A] [AddCommGroup F] [Module A F] [Module.Free A F] :
    50	    Module.Free A (A ⊗[A] F) := inferInstance
    51	
    52	/-! ## Transport flatness across an equivalence (the "B ≃ free" closer) -/
    53	
    54	/-- Flatness transports across a linear equivalence. -/
    55	example (A M N : Type u) [CommRing A] [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    56	    [Module.Flat A M] (e : N ≃ₗ[A] M) : Module.Flat A N :=
    57	  Module.Flat.of_linearEquiv e
    58	
    59	/-- Flatness transports across an *algebra* equivalence: `B ≃ₐ[A] (free A-algebra)` gives
    60	`Module.Flat A B` — the one-liner the route ends on, once such an equivalence exists. -/
    61	example (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (r : ℕ)
    62	    (e : B ≃ₐ[A] MvPolynomial (Fin r) A) : Module.Flat A B :=
    63	  Module.Flat.of_linearEquiv e.toLinearEquiv
    64	
    65	/-- Flatness composes along a tower `A → S → M` (`Module.Flat.trans`). -/
    66	example (A S M : Type u) [CommRing A] [CommRing S] [AddCommGroup M] [Algebra A S]
    67	    [Module A M] [Module S M] [IsScalarTower A S M] [Module.Flat A S] [Module.Flat S M] :
    68	    Module.Flat A M := Module.Flat.trans A S M
    69	
    70	/-! ## Flat-local-on-base, scheme-free (the local-triviality lever, when the ring map exists)
    71	
    72	`mult : Σ^r → Mat^{rk=r}` is Zariski-*locally* (not globally) trivial, so the route needs a
    73	flat-local-on-base lemma. Mathlib v4.29 has it at the **ring/module level, no schemes** — the
    74	levers to glue per-chart freeness into global flatness over the base. They are unusable here only
    75	because no `algebraMap A B` for `mult` exists yet. -/
    76	
    77	/-- **Module-level flat-local-on-base.** To prove `Module.Flat R M` it suffices to prove flatness of
    78	`LocalizedModule.Away r M` for each `r` in a spanning set `s ⊆ S` (a principal-open cover) — the
    79	scheme-free local-triviality lever (`Module.flat_of_localized_span`). -/
    80	example (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M]
    81	    (s : Set R) (spn : Ideal.span s = ⊤)
    82	    (h : ∀ r : s, Module.Flat R (LocalizedModule.Away r.1 M)) : Module.Flat R M :=
    83	  Module.flat_of_localized_span (S := R) (M := M) s spn h
    84	
    85	/-- **Ring-hom-level flat-local-on-base.** `RingHom.Flat` is a local property: its `propertyIsLocal`
    86	bundles `ofLocalizationSpanTarget`, `ofLocalizationSpan`, composition stability, and iso-respect —
    87	the descent package for gluing per-chart flatness of a ring map. -/
    88	example : RingHom.PropertyIsLocal @RingHom.Flat := RingHom.Flat.propertyIsLocal
    89	
    90	/-! ## Downstream levers (NOT in L1-0 scope — confirming they sit on `Module.Flat`)
    91	
    92	These belong to L1-1 (a later tide); pinned here only to confirm the flatness fact, once proved,
    93	feeds the height-additivity squeeze with no further hypothesis beyond Noetherianity. -/
    94	
    95	/-- Flat ⟹ going-down (instance). -/
    96	example (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Module.Flat A B] :
    97	    Algebra.HasGoingDown A B := inferInstance
    98	
    99	/-- The height-additivity lemma sits on going-down + Noetherianity (both rings Noetherian). -/
   100	example (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [IsNoetherianRing A]
   101	    [IsNoetherianRing B] [Algebra.HasGoingDown A B]
   102	    (p : Ideal A) [p.IsPrime] (P : Ideal B) [P.IsPrime] [P.LiesOver p] :
   103	    P.height = p.height + (P.map (Ideal.Quotient.mk (p.map (algebraMap A B)))).height :=
   104	  Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown p P
   105	
   106	end DLNFibre.Core.FlatProbe

