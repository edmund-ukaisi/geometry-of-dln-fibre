  jacobian_isUnit := isUnit_of_subsingleton _

end Constructions

variable {R S ι σ}

open Classical in
/-- If `P` is submersive, `PreSubmersivePresentation.aevalDifferential` is an isomorphism. -/
noncomputable def aevalDifferentialEquiv (P : SubmersivePresentation R S ι σ) :
