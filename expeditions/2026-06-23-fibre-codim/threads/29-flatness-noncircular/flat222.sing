// (2,2,2) r=1: test flatness of O(Sigma^r cap chart) over O(Mat^{<=r} cap chart)
// via the endpoint-normalized presentation S = R[A~]/(mult(A~) - E), E = diag(1,0).
// Variables: A1 (2x2) = a11..a22, A2 (2x2) = b11..b22, product P = A2*A1.
// Pivot chart: top-left entry of P invertible (P11 = b11 a11 + b12 a21 invertible).
ring r = 0, (a11,a12,a21,a22, b11,b12,b21,b22), dp;
// product P = A2 * A1
poly P11 = b11*a11 + b12*a21;
poly P12 = b11*a12 + b12*a22;
poly P21 = b21*a11 + b22*a21;
poly P22 = b21*a12 + b22*a22;
// Sigma^{<=1}: rank P <= 1 <=> det P = 0
poly detP = P11*P22 - P12*P21;
ideal Isig = detP;
"--- dim Sigma^bar (whole, rank<=1):";
dim(std(Isig));     // expect card - C = 8 - 1 = 7
"--- is detP irreducible? factorize:";
factorize(detP);
