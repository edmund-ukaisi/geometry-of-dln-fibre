from itertools import product, combinations_with_replacement

def comps(total,n):
    if n==1:
        yield (total,); return
    for x in range(total+1):
        for ys in comps(total-x,n-1): yield (x,)+ys

def parts(d):
    N=len(d)-1
    ints=[(a,b) for a in range(N+1) for b in range(a,N+1) if (a,b)"'!=(0,N)]
    # the omitted corner is fixed to zero; bounds follow Lean'"'s m_ab <= d_a
    for xs in product(*[range(d[a]+1) for a,b in ints]):
        m=dict(zip(ints,xs)); m[(0,N)]=0
        if all(sum(m[a,b] for a,b in m if a<=k<=b)==d[k] for k in range(N+1)):
            yield m

def cf(m,N):
    return sum(m[i-1,j-1]*m[u,v]
               for i in range(1,N+1) for u in range(i,N+1)
               for j in range(u,N+1) for v in range(j,N+1))

def is_hl(m,N):
    return all(x==0 or a==0 or b==N for (a,b),x in m.items())

def mofe(d,e):
    N=len(d)-1; m={(a,b):0 for a in range(N+1) for b in range(a,N+1)}
    for b in range(N): m[0,b]=e[b]
    for a in range(1,N+1): m[a,N]=e[a-1]+d[a]-d[a-1]
    return m

def g(d,e):
    N=len(d)-1
    return sum(e[i]*(e[j]+d[j+1]-d[j]) for i in range(N) for j in range(i+1))

anchor=list(parts((2,2,2)))
print('d222 counts all,HL,image =',len(anchor),sum(is_hl(m,2) for m in anchor),len({tuple(sorted(mofe((2,2,2),e).items())) for e in comps(2,2)}))
print('d222 (codim,HL,nonzero entries):')
for m in sorted(anchor,key=lambda m:(cf(m,2),not is_hl(m,2),tuple(m.values()))):
    print(cf(m,2),is_hl(m,2),[(p,x) for p,x in sorted(m.items()) if x])

cases=[]
for N,maxd in [(1,5),(2,5),(3,2)]:
    for d in combinations_with_replacement(range(maxd+1),N+1):
        ps=list(parts(d)); es=list(comps(d[0],N))
