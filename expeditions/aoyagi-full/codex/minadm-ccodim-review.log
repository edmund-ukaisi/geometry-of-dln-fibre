/-- **Self term.** `codimForm (concatDelta …) = 1`. -/
theorem codimForm_concatDelta {a b c d' : Fin (N + 1)}
    (hab : (a : ℕ) ≤ b) (hbc : (c : ℕ) = b + 1) (hcd : (c : ℕ) ≤ d') (ha1 : 1 ≤ (a : ℕ)) :
    codimForm N (concatDelta a b c d') = 1 := by
