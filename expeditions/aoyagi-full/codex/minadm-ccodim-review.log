        hlset={tuple(sorted(m.items())) for m in hl}
        if not (allmin==hlmin==qmin and image==hlset):
            print('FAIL',N,d,len(ps),len(hl),allmin,hlmin,qmin,image==hlset)
            raise SystemExit(1)
        cases.append((N,d,len(ps),len(hl),allmin))
print('stress cases checked =',len(cases))
print('strict all-vs-HL gaps = 0')
print('proper-subset cases =',sum(a>b for _,_,a,b,_ in cases),'of',len(cases))
