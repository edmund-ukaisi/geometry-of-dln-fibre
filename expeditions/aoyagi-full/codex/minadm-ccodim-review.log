/bin/bash -lc "python3 - <<'PY'
from itertools import product, combinations_with_replacement

def adm(M):
    L=len(M)-1
    bounds=[min(M[0],M[1])] + [M[j+1] for j in range(1,L)]
    for T in product(*[range(b+1) for b in bounds]):
        if all(T[j] <= T[i] for i in range(L) for j in range(i,L)) and T[-1]==0:
            yield T

def rho(M,T,x): return M[0] if x==0 else T[x-1]
def cascade(M,T,a,b):
    L=len(M)-1
    return rho(M,T,b) + M[a]-rho(M,T,a) if 0<=a<=L and 0<=b<=L else 0
def diff(M,T,a,b):
    return cascade(M,T,a,b)-cascade(M,T,a-1,b)-cascade(M,T,a,b+1)+cascade(M,T,a-1,b+1)
def mofe(M,T,a,b):
    L=len(M)-1
    e=[rho(M,T,c)-rho(M,T,c+1) for c in range(L)]
    if a==0 and b<L: return e[b]
    if a>=1 and b==L: return e[a-1]+(M[a]-M[a-1])
    return 0
def cf(f,L):
    return sum(f(i-1,j-1)*f(u,v) for i in range(1,L+1) for u in range(i,L+1)
               for j in range(u,L+1) for v in range(j,L+1))

checked=0
for L,maxm in [(1,5),(2,5),(3,3)]:
    for M in combinations_with_replacement(range(maxm+1),L+1):
        for T in adm(M):
            for i in range(1,L+1):
                for j in range(i,L+1):
                    assert diff(M,T,i-1,j-1)==mofe(M,T,i-1,j-1)
            for u in range(1,L+1):
                for v in range(u,L+1):
                    assert diff(M,T,u,v)==mofe(M,T,u,v)
            assert cf(lambda a,b:diff(M,T,a,b),L)==cf(lambda a,b:mofe(M,T,a,b),L)
            checked+=1
print('monotone admissible (M,T) read/codim checks =',checked)
M=(2,1); T=(0,); L=1
print('nonmonotone M,T =',M,T)
print('top read diff,mOfE =',diff(M,T,0,0),mofe(M,T,0,0))
# mOfE is Nat-valued, so its actual d-difference truncates at zero:
e=rho(M,T,0)-rho(M,T,1)
m_nat_right=e+max(M[1]-M[0],0)
print('right read diff,mOfE(Nat-sub) =',diff(M,T,1,1),m_nat_right)
print('corner diff,mOfE =',diff(M,T,0,1),0)
