#!/usr/bin/env python3
"""Thin launcher for the expedition-map CLI.

Adds this scripts/ directory to sys.path so ``expedition_map`` imports, then
dispatches. Keep this file dependency-free (stdlib only).
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from expedition_map.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
