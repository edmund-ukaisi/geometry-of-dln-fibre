#!/usr/bin/env bash
# cordon-test — battle-test the citation cordon (BOTH gate halves) against the adversarial fixtures.
#
#   docs/policies/citation-cordon.md   (the mechanism)
#   tests/{CordonFixtures,FixtureCited,CordonClean,CordonLeak}.lean  (fixtures + expected verdicts)
#
# A cordon unproven to catch a forgotten cite / a hidden axiom / a banked-consumes-a-forecast leak /
# a misplaced cite / a native_decide is worthless. This test exercises the two halves of the NEW
# mechanism (the whole-environment `cordon-audit` executable was deleted 2026-07-20):
#
#   PART 1 — the per-root SOUNDNESS gate `#assert_banked_clean` (Meta.Cordon), run over the fixture
#            decls from scratch modules via `lake env lean` (exit code + message):
#     (i)   SUCCEEDS on a clean cited decl (CordonClean.cleanUsesCite) — a declared cite is permitted;
#     (ii)  FAILS naming the unaccounted axiom on the untagged-axiom consumer (usesUntagged);
#     (iii) FAILS naming the unaccounted axiom on the opaque-hidden consumer (usesOpaque);
#     (iv)  FAILS naming the leaked forecast on the blueprint-leak consumer (CordonLeak.bankedLeak);
#     (iv-b/c/d) the BATCHED gate `#assert_banked_clean_batch [..]`: a clean list PASSES with the union
#            summary (which also names the cited-SOURCE set in use); a dirty list (untagged axiom /
#            blueprint leak) FAILS via slow-path attribution naming the CULPRIT ROOT + the offending
#            axiom/forecast (the batch is forget-proof too);
#     (iv-e) the batch FAST-PATH surfaces an OPAQUE-hidden axiom (guards `collectAxiomsBatch`'s opaque arm);
#     (iv-f) an EMPTY root list ERRORS (a gate over zero roots must not pass green);
#     (v)   still REJECTS `@[cited]` on a non-axiom, and `@[cited ""]` (empty source) at elaboration.
#
#   PART 2 — the source-level grep gate `scripts/cordon`, run over a fixture tree:
#     (vi)  FAILS naming an untagged axiom, a misplaced cited axiom, and a `native_decide`;
#     (vii) PASSES a tree whose only axiom is located + tagged;
#     (viii–x) the source-scanner FALSE-NEGATIVE regressions (external review 2026-07-20): a UNICODE-named
#            axiom is detected [1a]; a consumed same-line `@[cited]` does NOT tag the next axiom [1b]; a
#            `/-` inside a string literal does NOT comment out later axioms [1c];
#     (xi)  an empty/nonexistent scope (0 files scanned) ERRORS (not a vacuous green).
#
# Exits 0 iff every assertion holds. Deterministic. (Break any gate and this test goes red.)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LEAN_DIR="$(dirname "$SCRIPT_DIR")"
cd "$LEAN_DIR"

pass=0 ; fail=0
check() { # check <label> <expected-substring> <actual>
  if printf '%s' "$3" | grep -qF -- "$2"; then
    echo "  PASS: $1"; pass=$((pass+1))
  else
    echo "  FAIL: $1"; echo "        expected to contain: $2"; echo "        got: $3"; fail=$((fail+1))
  fi
}
check_exit() { # check_exit <label> <expected-code> <actual-code>
  if [ "$3" = "$2" ]; then echo "  PASS: $1 (exit $3)"; pass=$((pass+1));
  else echo "  FAIL: $1 (expected exit $2, got $3)"; fail=$((fail+1)); fi
}

echo "== building cordon lib + fixtures (throttled; NOT DLNFibre) =="
"$SCRIPT_DIR/lb" Meta CordonFixtures >&2
source "$HOME/.elan/env" 2>/dev/null || true

# Run `#assert_banked_clean <decl>` in a scratch module importing <imp>; sets globals OUT, CODE.
assert_cmd() { # assert_cmd <import-module> <fully-qualified-decl>
  local scratch; scratch="$(mktemp --suffix=.lean)"
  cat > "$scratch" <<LEAN
import Meta.Cordon
import $1
#assert_banked_clean $2
LEAN
  set +e
  OUT="$(lake env lean "$scratch" 2>&1)"; CODE=$?
  set -e
  rm -f "$scratch"
}

# Run `#assert_banked_clean_batch [<decls>]` in a scratch module with the given imports; sets OUT, CODE.
assert_batch() { # assert_batch <import-lines> <comma-separated-decls>
  local scratch; scratch="$(mktemp --suffix=.lean)"
  { echo "import Meta.Cordon"; printf '%s\n' "$1"; echo "#assert_banked_clean_batch [$2]"; } > "$scratch"
  set +e
  OUT="$(lake env lean "$scratch" 2>&1)"; CODE=$?
  set -e
  rm -f "$scratch"
}

echo "== PART 1 — the per-root #assert_banked_clean soundness gate =="

echo "-- (i) clean cited decl SUCCEEDS (a declared cite is permitted) --"
assert_cmd CordonClean CordonClean.cleanUsesCite
echo "$OUT"
check_exit "clean cited decl passes" 0 "$CODE"
check "reports the located cite source" "Fixture Source B" "$OUT"

echo "-- (ii) untagged-axiom consumer FAILS (UNACCOUNTED) --"
assert_cmd CordonFixtures CordonFixtures.usesUntagged
echo "$OUT"
check_exit "untagged-axiom consumer fails" 1 "$CODE"
check "names the unaccounted axiom" "untaggedFixtureAxiom" "$OUT"
check "labels it UNACCOUNTED" "UNACCOUNTED" "$OUT"

echo "-- (iii) opaque-hidden-axiom consumer FAILS (collectAxioms traverses opaque value) --"
assert_cmd CordonFixtures CordonFixtures.usesOpaque
echo "$OUT"
check_exit "opaque-hidden consumer fails" 1 "$CODE"
check "names the opaque-hidden axiom" "hiddenFixtureAxiom" "$OUT"

echo "-- (iv) blueprint-leak consumer FAILS (banked rests on a forecast) --"
assert_cmd CordonLeak CordonLeak.bankedLeak
echo "$OUT"
check_exit "blueprint-leak consumer fails" 1 "$CODE"
check "labels it a LEAK" "LEAK" "$OUT"
check "names the leaked forecast" "CordonLeak.forecast" "$OUT"

echo "-- (iv-b) BATCH gate: a clean list PASSES with the union summary + the cited-source SET --"
assert_batch "import CordonClean" "CordonClean.cleanUsesCite"
echo "$OUT"
check_exit "batch clean list passes" 0 "$CODE"
check "batch emits the union summary" "banked-clean (union rests only on foundational + cited)" "$OUT"
# The summary also names the cited SOURCE set in the union (mitigates the per-root cite-profile loss:
# a clean-three root that silently acquires a cite dependency becomes visible in this set).
check "batch summary names the cite in use" "cites in use: Fixture Source B" "$OUT"

echo "-- (iv-c) BATCH gate: a list with an untagged-axiom root FAILS naming the culprit ROOT + axiom --"
assert_batch $'import CordonClean\nimport CordonFixtures' "CordonClean.cleanUsesCite, CordonFixtures.usesUntagged"
echo "$OUT"
check_exit "batch dirty list fails" 1 "$CODE"
check "batch names the culprit root" "CordonFixtures.usesUntagged" "$OUT"
check "batch names the unaccounted axiom" "untaggedFixtureAxiom" "$OUT"

echo "-- (iv-d) BATCH gate: a list with a blueprint-leak root FAILS naming the culprit ROOT + forecast --"
assert_batch "import CordonLeak" "CordonLeak.bankedLeak"
echo "$OUT"
check_exit "batch blueprint-leak fails" 1 "$CODE"
check "batch labels it a LEAK" "LEAK" "$OUT"
check "batch names the leaked forecast" "CordonLeak.forecast" "$OUT"

echo "-- (iv-e) BATCH FAST-PATH opaque arm: [usesOpaque] FAILS (guards collectAxiomsBatch's opaque value) --"
# The opaque-hidden axiom must surface through the BATCH union walk, not only the per-root path: if
# `collectAxiomsBatch` failed to descend into `opaqueInfo.value`, the union would be clean and the batch
# would (wrongly) print the green summary. Asserting the batch FAILS here is the guard on that arm.
assert_batch "import CordonFixtures" "CordonFixtures.usesOpaque"
echo "$OUT"
check_exit "batch fails on the opaque-hidden axiom" 1 "$CODE"
check "batch names the opaque-hidden axiom" "hiddenFixtureAxiom" "$OUT"

echo "-- (iv-f) BATCH gate: an EMPTY root list ERRORS (a gate over zero roots must not pass green) --"
assert_batch "import CordonClean" ""
echo "$OUT"
check_exit "batch empty root list errors" 1 "$CODE"
check "batch empty-list message" "EMPTY root list" "$OUT"

echo "-- (v) elaboration rejections unchanged --"
SCRATCH="$(mktemp --suffix=.lean)"
cat > "$SCRATCH" <<'LEAN'
import Meta.Cordon
open Meta.Cordon
@[cited "wrong target"]
def notAnAxiom : Nat := 0
LEAN
set +e
OUT_REJ="$(lake env lean "$SCRATCH" 2>&1)"; CODE_REJ=$?
set -e
rm -f "$SCRATCH"
check_exit "@[cited] on a def fails to compile" 1 "$CODE_REJ"
check "rejection message" "may only tag a cited external result declared as \`axiom\`" "$OUT_REJ"

SCRATCH2="$(mktemp --suffix=.lean)"
cat > "$SCRATCH2" <<'LEAN'
import Meta.Cordon
open Meta.Cordon
@[cited ""]
axiom emptySourceAx : True
LEAN
set +e
OUT_EMPTY="$(lake env lean "$SCRATCH2" 2>&1)"; CODE_EMPTY=$?
set -e
rm -f "$SCRATCH2"
check_exit "@[cited \"\"] fails to compile" 1 "$CODE_EMPTY"
check "empty-source rejection message" "non-empty citation source" "$OUT_EMPTY"

echo "== PART 2 — the source-level grep gate scripts/cordon =="

echo "-- (vi) grep gate FAILS on an untagged axiom + a misplaced cite + a native_decide --"
TREE="$(mktemp -d)"; mkdir -p "$TREE/sub"
cat > "$TREE/GoodCited.lean" <<'LEAN'
@[cited "Fixture Source B"]
axiom goodCite : True
LEAN
cat > "$TREE/sub/Untagged.lean" <<'LEAN'
axiom untaggedGrepAxiom : True
LEAN
cat > "$TREE/Misplaced.lean" <<'LEAN'
@[cited "Fixture Source D (misplaced)"]
axiom misplacedGrepAxiom : True
LEAN
cat > "$TREE/Nd.lean" <<'LEAN'
theorem ndFixture : True := by native_decide
LEAN
set +e
OUT_GREP="$(python3 "$SCRIPT_DIR/cordon" "$TREE" 2>&1)"; CODE_GREP=$?
set -e
echo "$OUT_GREP"
check_exit "grep gate fails on violations" 1 "$CODE_GREP"
check "grep names the untagged axiom" "untaggedGrepAxiom" "$OUT_GREP"
check "grep names the misplaced cite" "misplacedGrepAxiom" "$OUT_GREP"
check "grep names the native_decide" "native_decide" "$OUT_GREP"
rm -rf "$TREE"

echo "-- (vii) grep gate PASSES a tree whose only axiom is located + tagged --"
TREE2="$(mktemp -d)"
cat > "$TREE2/OkCited.lean" <<'LEAN'
@[cited "Fixture Source B"]
axiom okCite : True
LEAN
set +e
OUT_OK="$(python3 "$SCRIPT_DIR/cordon" "$TREE2" 2>&1)"; CODE_OK=$?
set -e
echo "$OUT_OK"
check_exit "grep gate passes a clean located+tagged tree" 0 "$CODE_OK"
rm -rf "$TREE2"

# ── Regression tests for the source-scanner FALSE NEGATIVES (external review, 2026-07-20) ──────────
# Each targets a specific pre-fix false negative: without its fix the tree scans GREEN (the axiom is
# not detected / reads as tagged / is hidden behind a fake block comment), so the check_exit below
# RED-fails under the old code and passes after.

echo "-- (viii) [1a] grep DETECTS a UNICODE-named axiom (ASCII-only regex missed \`axiom ψ\`) --"
TREE3="$(mktemp -d)"
printf 'axiom \xcf\x88 : True\n' > "$TREE3/UnicodeAx.lean"   # ψ = U+03C8, untagged + not located
set +e
OUT_U="$(python3 "$SCRIPT_DIR/cordon" "$TREE3" 2>&1)"; CODE_U=$?
set -e
echo "$OUT_U"
check_exit "grep fails on a unicode-named untagged axiom" 1 "$CODE_U"
check "grep flags the unicode-axiom file" "UnicodeAx.lean" "$OUT_U"
rm -rf "$TREE3"

echo "-- (ix) [1b] grep does NOT let a consumed same-line @[cited] tag the NEXT axiom --"
TREE4="$(mktemp -d)"
# `@[cited]` is CONSUMED by fooCited on its own line; barUntagged (next line, located file) is UNTAGGED.
cat > "$TREE4/FooCited.lean" <<'LEAN'
@[cited "Fixture Source B"] axiom fooCited : True
axiom barUntagged : True
LEAN
set +e
OUT_C="$(python3 "$SCRIPT_DIR/cordon" "$TREE4" 2>&1)"; CODE_C=$?
set -e
echo "$OUT_C"
check_exit "grep fails on the untagged axiom after a tagged one" 1 "$CODE_C"
check "grep names the untagged next-line axiom" "barUntagged" "$OUT_C"
check "grep labels it UNTAGGED" "UNTAGGED" "$OUT_C"
rm -rf "$TREE4"

echo "-- (x) [1c] grep is STRING-AWARE: a \`/-\` inside a string does not comment out later axioms --"
TREE5="$(mktemp -d)"
cat > "$TREE5/StringSlashAx.lean" <<'LEAN'
def marker := "/-"
axiom afterStringAx : True
LEAN
set +e
OUT_S="$(python3 "$SCRIPT_DIR/cordon" "$TREE5" 2>&1)"; CODE_S=$?
set -e
echo "$OUT_S"
check_exit "grep fails on an axiom after a string containing /-" 1 "$CODE_S"
check "grep names the axiom after the string" "afterStringAx" "$OUT_S"
rm -rf "$TREE5"

echo "-- (xi) [vacuous-green] grep ERRORS on an empty/nonexistent scope (0 files scanned) --"
set +e
OUT_E0="$(python3 "$SCRIPT_DIR/cordon" "/tmp/cordon-nonexistent-$$-$RANDOM" 2>&1)"; CODE_E0=$?
set -e
echo "$OUT_E0"
check_exit "grep errors on a nonexistent tree" 2 "$CODE_E0"
check "grep names the zero-files error" "scanned 0 .lean files" "$OUT_E0"
TREE6="$(mktemp -d)"   # exists but contains no .lean files
set +e
OUT_E1="$(python3 "$SCRIPT_DIR/cordon" "$TREE6" 2>&1)"; CODE_E1=$?
set -e
echo "$OUT_E1"
check_exit "grep errors on an empty existing tree" 2 "$CODE_E1"
rm -rf "$TREE6"

echo ""
echo "cordon-test: $pass passed, $fail failed."
[ "$fail" = 0 ]
